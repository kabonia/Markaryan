# ---- Скопируйте в .env и заполните. Этот файл никому не отправляйте. ----

# Порядок ИИ: первый отвечает, следующие — запасные. Без ключа провайдер пропускается.
AI_PROVIDERS=openrouter,gigachat,yandex

# OpenRouter (openrouter.ai → Keys): один ключ для Claude, GPT и Gemini.
# Первая модель отвечает, остальные OpenRouter подставляет сам, если первая недоступна.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=anthropic/claude-opus-5.5,openai/gpt-6.2-astra,google/gemini-4-carbon
# Глубина рассуждения: low, medium, high, xhigh, max. Пусто — high для дизайна и счёта по фото, medium для чата.
OPENROUTER_EFFORT=
# deny — только провайдеры, которые не хранят запросы (фото и планы клиентов). Может сузить выбор моделей.
OPENROUTER_DATA_COLLECTION=
# Другой шлюз с API как у OpenAI (например, российский посредник с оплатой в рублях): адрес /v1 и его названия моделей.
# OPENROUTER_BASE=https://openrouter.ai/api/v1
# Модели, из которых в приложении выбирают на шаге «Дизайн» (дизайн и расстановка). Выбранная отвечает первой,
# модели из OPENROUTER_MODELS остаются запасными. Пусто — Claude Opus 5.5, Claude Sonnet 5.5, GPT‑6.2 Astra, Gemini 4 Carbon.
# OPENROUTER_DESIGN_CHOICES=anthropic/claude-opus-5.5,anthropic/claude-sonnet-5.5,openai/gpt-6.2-astra,google/gemini-4-carbon

# GigaChat (developers.sber.ru → Личный кабинет → GigaChat API → «Ключ авторизации»)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлицо, GIGACHAT_API_B2B / GIGACHAT_API_CORP — ИП и компании
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

# YandexGPT (Yandex Cloud → сервисный аккаунт с ролями ai.languageModels.user и ai.imageGeneration.user → API‑ключ)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
YANDEX_VISION_MODEL=qwen3.6-35b-a3b
# Картинки по описанию, если нет движков выше (Alice AI ART)
YANDEX_ART_MODEL=aliceai-image-art-3.0

# Необязательно: общий токен приложения (тот же вписывается в AIServer.plist)
APP_TOKEN=

# ---- Картинки: фотореализм по точной 3D‑модели и картинки по описанию ----
# Порядок движков: openrouter (его модели картинок, тот же ключ), openai, bfl — каждый только при заданном ключе.
IMAGE_ENGINES=openrouter,openai,bfl
# Модели картинок OpenRouter по порядку: первая отвечает, следующие подменяют её при сбое.
OPENROUTER_IMAGE_MODELS=google/gemini-3-pro-image,openai/gpt-image-2.6-sunburst,black-forest-labs/flux-3-image
# Модели 3D‑рендера, из которых выбирают в приложении на шаге «Дизайн». Выбранная рисует первой, движки выше — запасные.
# Пусто — Nano Banana Pro, GPT Image 2.6 Sunburst, Seedream 5.0 Pro.
# OPENROUTER_RENDER_CHOICES=google/gemini-3-pro-image,openai/gpt-image-2.6-sunburst,bytedance-seed/seedream-5-0-pro
# Разрешение там, где модель его принимает: 1K, 2K или 4K.
IMAGE_RESOLUTION=2K
# Напрямую, без OpenRouter (адреса можно направить через прокси за рубежом; пусто — движок выключен):
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# OPENAI_BASE=https://api.openai.com/v1
BFL_API_KEY=
BFL_MODEL=flux-3-image
# BFL_BASE=https://api.bfl.ai/v1

# Дневные лимиты на одну установку приложения
LIMIT_CHAT=150
LIMIT_JSON=25
LIMIT_VISION=40
LIMIT_IMAGE_EDIT=24
LIMIT_IMAGE=15
LIMIT_PER_MINUTE=20

# ---- hh.ru (dev.hh.ru → приложение «АртСтрой») ----
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=https://pastura.2-26-100-30.sslip.io/v1/auth/hh/callback
HH_USER_AGENT=ArtStroy/1.0 (sochitender@mail.ru)
# Придумайте длинный пароль: им открывается ссылка подключения аккаунта hh.ru
HH_ADMIN_KEY=
# Адрес этого сервера снаружи (для уведомлений hh.ru о новых откликах и сообщениях)
PUBLIC_URL=https://pastura.2-26-100-30.sslip.io
# free — публиковать только бесплатно; any — тратить и купленные публикации
HH_PUBLICATION=free
HH_AUTO_PUBLISH=true
HH_MAX_PER_DAY=5
HH_MAX_PER_INSTALL=2
# Контакт в вакансии (необязательно)
HH_CONTACT_NAME=
HH_CONTACT_PHONE=

# ---- Avito (avito.ru/professionals → Интеграции и API / developers.avito.ru → приложение) ----
# Redirect URL в настройках приложения Avito: https://pastura.2-26-100-30.sslip.io/v1/auth/avito/callback
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# package — только из купленного пакета вакансий; packageOrSingle — можно платить с кошелька Avito
AVITO_BILLING=package
AVITO_MAX_PER_DAY=5
AVITO_MAX_PER_INSTALL=2

# Ключ для управления списком подрядчиков-партнёров
PARTNERS_ADMIN_KEY=

# Уведомления об ошибках в приложении (бот от @BotFather и id вашего чата)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Дешёвая модель для ИИ-помощника
OPENROUTER_HELPER_MODELS=anthropic/claude-haiku-5.5
