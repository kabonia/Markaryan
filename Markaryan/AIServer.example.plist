<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Шаблон. Скопируйте в Markaryan/AIServer.plist (он в .gitignore и в git не попадает) и заполните.
  OPENROUTER_API_KEY — ключ OpenRouter (sk-or-…): ИИ‑чат, дизайн, рендеры, дизайн по фото и «Сколько в пачке»
                       работают прямо из приложения, без сервера. Поставьте на ключ лимит расходов на openrouter.ai.
  AI_SERVER_URL      — сервер ИИ приложения (если развёрнут). Если задан, ИИ идёт через сервер, а не через ключ.
  MARKET_SERVER_URL  — сервер рыночных цен и партнёров; пусто — используется AI_SERVER_URL.
  APP_TOKEN          — только если на сервере в .env задан APP_TOKEN.
  Адреса со словом «example» приложение игнорирует.
-->
<plist version="1.0">
<dict>
	<key>OPENROUTER_API_KEY</key>
	<string>ВСТАВЬТЕ_КЛЮЧ_sk-or-...</string>
	<key>AI_SERVER_URL</key>
	<string>https://ai.example.ru</string>
	<key>MARKET_SERVER_URL</key>
	<string>https://prices.example.ru</string>
	<key>APP_TOKEN</key>
	<string></string>
</dict>
</plist>
