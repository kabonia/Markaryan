    "Площадь = (длина + 2 × свес) × (ширина + 2 × свес) / cos(угол)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area = (length + 2 × overhang) × (width + 2 × overhang) / cos(angle)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área = (largo + 2 × voladizo) × (ancho + 2 × voladizo) / cos(ángulo)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面积 = (长 + 2 × 挑檐) × (宽 + 2 × 挑檐) / cos(坡角)"
          }
        }
      }
    },
