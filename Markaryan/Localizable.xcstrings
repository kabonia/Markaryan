          }
        }
      }
    },
    "Что можно оптимизировать без потери качества?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where can I save without sacrificing quality?"
          }
        },
