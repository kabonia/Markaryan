          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "Все материалы объекта, сложенные по работам, с нормами и отходами; техника и рейсы доставки.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project material quantities totaled across work items, with usage rates and waste allowances, plus equipment and delivery trips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Totales de materiales del proyecto, sumados a partir de las partidas de obra e incluidos los factores de consumo y desperdicio. También se incluyen la maquinaria y los viajes de entrega."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇总各施工项目的材料用量，计入消耗定额和损耗，并列出施工机械和配送车次。"
          }
        }
      }
    },
    "Все обмеры": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All measurements"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las mediciones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部测量数据"
          }
        }
      }
    },
    "Все поверхности": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All surfaces"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las superficies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有表面"
          }
        }
      }
    },
    "Все способы узнать стоимость работ и материалов: по документам, по площади или по сохранённым расчётам.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find out what labor and materials will cost using your documents, square footage, or saved calculations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las formas de conocer el costo de la mano de obra y los materiales: a partir de documentos, según la superficie o con tus cálculos guardados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想了解施工费和材料费？可按资料或面积估算，也可查看已保存的计算结果。"
          }
        }
      }
    },
    "Все этапы закрыты": {
      "localizations": {
        "en": {
