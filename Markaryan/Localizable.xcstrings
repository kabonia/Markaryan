          }
        }
      }
    },
    "Расчёты, сметы, объекты, планировки, фото и журнал хранятся только на вашем iPhone. Удаление приложения удаляет их.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculations, estimates, projects, floor plans, photos, and the journal are stored only on your iPhone. Deleting the app deletes them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cálculos, presupuestos, proyectos, planos, fotos y el registro se guardan solo en tu iPhone. Si eliminas la app, se borran."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算结果、工程估价单、项目、平面布局、照片和日志仅保存在您的 iPhone 上。删除应用会一并删除这些数据。"
          }
        }
      }
    },
