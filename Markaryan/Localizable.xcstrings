    "Измерение длин, площадей и периметра камерой iPhone — без рулетки.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure lengths, areas, and perimeters with your iPhone camera, no tape measure needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide longitudes, áreas y perímetros con la cámara del iPhone, sin cinta métrica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 iPhone 相机测量长度、面积和周长,无需卷尺。"
          }
        }
      }
    },
    "Измерьте камерой.\nПосчитайте за минуту.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure with your camera.\nCalculate in a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide con la cámara.\nCalcula en un minuto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用相机测量，\n一分钟算完。"
          }
        }
      }
    },
    "Измерьте рулеткой одну стену": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure one wall with a tape measure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide un muro con cinta métrica"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用卷尺量一面墙的长度"
          }
        }
      }
    },
    "Измеряйте расстояния и площадь пола. Размещайте на площадке плиту, стены, крышу, окна, двери и септик с заданными размерами.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure distances and floor area. Place slabs, walls, roofs, windows, doors, and septic tanks on your site using the dimensions you specify."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide distancias y el área del piso. Coloca en el terreno una losa, muros, un techo, ventanas, puertas y una fosa séptica con las dimensiones que indiques."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量距离和地面面积。在现场按指定尺寸摆放板、墙体、屋顶、门窗和化粪池模型。"
          }
        }
      }
    },
