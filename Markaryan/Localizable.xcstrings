    },
    "Цемент · песок · щебень · вода на замес": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cement · sand · crushed stone · water per batch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cemento · arena · piedra triturada · agua por tanda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每盘用量：水泥 · 砂 · 碎石 · 水"
          }
        }
      }
    },
    "Цемент на 1 м³ = 980 л / (1/3,1 + (песок + щебень)/2,65 + В/Ц); песок и щебень = цемент × части; вода = цемент × В/Ц. Насыпная плотность: песок 1500, щебень 1450 кг/м³": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cement per 1 m³ = 980 L / (1/3.1 + (sand parts + crushed stone parts)/2.65 + w/c). Sand and crushed stone weights = cement weight × their respective mix parts. Water weight = cement weight × w/c. Bulk density: sand 1500 kg/m³, crushed stone 1450 kg/m³"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cemento por 1 m³ = 980 L / (1/3,1 + (arena + grava triturada)/2,65 + A/C); arena y grava triturada = cemento × sus respectivas partes; agua = cemento × A/C. Densidad aparente: arena 1500, grava triturada 1450 kg/m³."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 1 m³ 混凝土的水泥用量 = 980 L / (1/3.1 + (砂份数 + 碎石份数)/2.65 + 水灰比)；砂、碎石用量 = 水泥用量 × 各自的配比份数；用水量 = 水泥用量 × 水灰比。堆积密度：砂 1500 kg/m³，碎石 1450 kg/m³。"
          }
        }
      }
    },
    "Цемент на 1 м³ по пропорциям": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
