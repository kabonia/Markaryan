    },
    "Получились слишком большие значения. Проверьте размеры и единицы измерения.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The values are too high. Check your dimensions and units."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores obtenidos son demasiado grandes. Revisa las dimensiones y las unidades de medida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果数值过大。请检查尺寸和单位。"
          }
        }
      }
    },
    "Получите визуализацию и уточняйте словами.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the rendering and describe any changes you’d like to make."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén la visualización y ajústala escribiendo los cambios que quieras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取效果图,并用文字继续调整。"
          }
        }
      }
    },
    "Получить ключ на console.anthropic.com": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a key at console.anthropic.com"
          }
        },
        "es": {
