    "Спокойные нейтральные тона, матовые фасады, скрытое хранение и мягкая подсветка.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft neutrals, matte cabinet fronts, concealed storage, and soft accent lighting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonos neutros y tranquilos, frentes mate, almacenamiento oculto e iluminación suave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的中性色调、哑光柜门、隐藏式收纳和柔和的辅助照明。"
          }
        }
      }
    },
    "Споты по сетке 1,2 м для общего света, подвесной светильник над главной зоной, тёплый свет 3000 K.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlights on a 1.2 m grid for general lighting, a pendant light over the main area, warm 3000 K light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Focos en retícula de 1,2 m para la iluminación general, lámpara colgante sobre la zona principal y luz cálida de 3000 K."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "射灯按 1.2 m 间距呈网格布置，用于一般照明；主要活动区上方装吊灯，采用 3000 K 暖光。"
          }
        }
      }
    },
