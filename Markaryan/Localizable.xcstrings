{
  "sourceLanguage": "ru",
  "strings": {
    "\n\nВАЖНО: в прошлом ответе не было предметов или ни один не поместился. Обязательно заполни items реальными предметами с размерами в метрах, которые помещаются в эту комнату.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nIMPORTANT: Your previous response either included no items or none of the items fit. Populate items with real objects that fit in this room, and give their dimensions in meters."
          }
        }
      }
    },
