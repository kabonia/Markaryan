    },
    "Отправьте калькуляторы и смету тем, кто строится": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the calculators and cost estimate with anyone who's building."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía las calculadoras y el presupuesto a quienes están construyendo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将计算器和工程预算发给正在建房的人"
          }
        }
      }
    },
    "Отправьте смету или запросите цену у партнёров.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the estimate or request a quote from partners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el presupuesto o pide precio a nuestros socios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送工程估算单，或向合作商家询价。"
          }
        }
      }
    },
    "Отсканируйте помещение лидаром или сфотографируйте — получите план, стиль, фотореалистичные визуализации, чертежи и смету дизайн‑проекта.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan your room with LiDAR or take a photo to get a floor plan, a design concept, photorealistic renderings, drawings, and a cost estimate for the design."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el espacio con LiDAR o tómale una foto: obtendrás el plano, el estilo, renders fotorrealistas, planos técnicos y el presupuesto del proyecto de diseño."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 LiDAR 扫描房间或拍照，即可获得平面图、风格方案、照片级效果图、图纸和装修预算。"
          }
        }
      }
    },
    "Отступы дома и построек от границ, процент застройки и разрывы проверятся, когда появится макет дома после скана.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once your scan is ready as a house model, we’ll check setbacks for your house and other buildings, the percentage of the lot they cover, and spacing between buildings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el escaneo genere el modelo de la casa, se verificarán los retiros de la casa y otras construcciones respecto a los linderos, el porcentaje de ocupación del lote y las distancias entre construcciones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描生成房屋模型后，将核查房屋及附属建筑的用地红线退距、建筑密度和建筑间距。"
          }
        }
      }
    },
    "Отчёт по объекту": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project report"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe del proyecto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目报告"
          }
        }
      }
    },
    "Оценить приложение": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorar la app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给应用评分"
          }
        }
      }
    },
    "Оценка количества материалов, не проектный расчёт несущих конструкций.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Material quantity estimate, not a structural design calculation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación de la cantidad de materiales. No sustituye el cálculo de la estructura portante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅估算材料用量，不用于承重结构设计计算。"
          }
        }
      }
    },
    "Очистить": {
      "localizations": {
