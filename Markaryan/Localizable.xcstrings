            "state": "translated",
            "value": "AI is reviewing the calculation…"
          }
        }
      }
    },
    "ИИ не подключён: впишите OPENROUTER_API_KEY в AIServer.plist и пересоберите приложение.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI isn't connected: add OPENROUTER_API_KEY to AIServer.plist and rebuild the app."
          }
        }
      }
    },
    "ИИ не подключён: впишите OPENROUTER_API_KEY в AIServer.plist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI isn't connected: add OPENROUTER_API_KEY to AIServer.plist."
          }
        }
      }
    },
    "ИИ не прислал ответ. Попробуйте переформулировать вопрос.": {
      "extractionState": "manual",
