          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen · espesor · paquetes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体积 · 厚度 · 包数"
          }
        }
      }
    },
    "Объём банки": {
