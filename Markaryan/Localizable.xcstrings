    "Проходы оставлены не уже 0,7 м, зона открывания двери свободна.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkways are at least 0.7 m wide, and the door swing area is clear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos tienen al menos 0,7 m de ancho y la puerta puede abrirse sin obstáculos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通道净宽不小于 0.7 m，门扇开启范围内无障碍。"
          }
        }
      }
    },
    "Проходы, двери и окна свободны": {
