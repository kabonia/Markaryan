            "state": "translated",
            "value": "A un agua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单坡"
          }
        }
      }
    },
    "Озеленение": {
      "extractionState": "manual",
