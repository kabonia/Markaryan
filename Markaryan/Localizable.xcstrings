    "Масса (теоретическая)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight (theoretical)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa teórica"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重量（理论值）"
          }
        }
      }
    },
    "Масса = π × (диаметр / 2)² × 7850 кг/м³ × длина × количество × запас. Прутки = стержни с запасом / целых отрезков из прутка, вверх; цена — по массе целых прутков": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight = π × (diameter / 2)² × 7850 kg/m³ × length × quantity × waste factor. Full bars to buy = required pieces (including waste allowance) / pieces you can cut from one bar, rounded up. Cost is based on the total weight of the full bars"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso = π × (diámetro / 2)² × 7850 kg/m³ × largo × cantidad × factor de desperdicio. Barras = piezas con margen de desperdicio / piezas enteras que salen de cada barra; redondea hacia arriba. El precio se calcula según el peso de las barras completas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重量 = π × (直径 / 2)² × 7850 kg/m³ × 长度 × 数量 × 损耗系数。根数 = 含损耗的钢筋段数 / 每根整料可切段数，向上取整；价格按整根重量计算"
          }
        }
      }
    },
    "Масса = площадь × толщина в мм × расход × запас. Мешки = масса / масса мешка, вверх": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight = area × thickness in mm × material use rate × waste factor. Bags = total weight / weight per bag, rounded up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa = área × espesor en mm × consumo × factor de desperdicio. Sacos = masa / masa por saco; redondea hacia arriba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "质量 = 面积 × 厚度（mm）× 用量 × 损耗系数。袋数 = 质量 / 每袋质量，向上取整"
          }
        }
      }
    },
