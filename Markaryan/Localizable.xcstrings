    "Плюс плитка, ламинат, покраска, потолки и межкомнатные двери.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tile, laminate, painting, ceilings and interior doors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Además, incluye revestimientos cerámicos, piso laminado, pintura, cielos rasos y puertas interiores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另含瓷砖铺贴、强化复合地板铺装、涂刷、顶棚施工和室内门安装。"
          }
        }
      }
    },
    "Плюс штукатурка стен и стяжка — под чистовую отделку (white box).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus plastered walls and floor screed, ready for final finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Además, incluye enlucido de muros y una capa de nivelación del piso para dejar todo listo para los acabados finales (white box)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另含墙面抹灰和地面找平，达到可进行饰面施工的交付标准（white box）。"
          }
        }
      }
    },
    "Плёнка полиэтиленовая 200 мкм": {
      "extractionState": "manual",
