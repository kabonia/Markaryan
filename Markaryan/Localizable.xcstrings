    "Размеры взяты из плана комнаты. Перепроверьте их перед закупкой.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensions come from the room plan. Double-check them before you buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dimensiones se tomaron del plano de la habitación. Verifícalas antes de comprar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸取自房间平面图。采购前请复核。"
          }
        }
      }
    },
    "Размеры дома, окон и крыши, площади": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensions and areas for the house, windows, and roof"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medidas y superficies de la casa, las ventanas y el tejado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房屋、窗户和屋顶的尺寸及面积"
          }
        }
      }
    },
    "Размеры проверьте рулеткой перед заказом мебели.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-check the dimensions with a tape measure before ordering furniture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica las medidas con cinta métrica antes de pedir los muebles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订购家具前，请用卷尺复核尺寸。"
          }
        }
      }
    },
    "Размеры уже подставлены из плана: пол %@ м², стены %@ м², окна и двери %@ м².": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Areas from the floor plan are already filled in: floor %@ m², walls %@ m², window and door openings %@ m²."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya cargamos las áreas del plano: piso %@ m², paredes %@ m², ventanas y puertas %@ m²."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从平面图自动填入面积：地面 %@ m²、墙面 %@ m²、门窗洞口 %@ m²。"
          }
        }
      }
    },
    "Размеры — по лидар‑скану, мм. Перед заказом мебели и сантехники проверьте ключевые размеры рулеткой.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensions are from the LiDAR scan, in mm. Check key dimensions with a tape measure before ordering furniture and plumbing fixtures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiones según el escaneo LiDAR, en mm. Antes de pedir muebles y sanitarios, verifica las medidas clave con un flexómetro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸根据 LiDAR 扫描测得，单位为 mm。订购家具和洁具前，请用卷尺复核关键尺寸。"
          }
        }
      }
    },
    "Размеры — по фото и стенам, снятым лидаром (±2–3 см). Окно, отмеченное на одном фото, — с серой меткой: проверьте рулеткой.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensions are based on photos and LiDAR scans of the walls (±2–3 cm). Windows identified in only one photo have a gray marker. Verify their dimensions with a tape measure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dimensiones se calculan con fotos y con paredes medidas con LiDAR (±2–3 cm). Una ventana marcada en una sola foto lleva una etiqueta gris: verifícala con cinta métrica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸根据照片和 LiDAR 扫描的墙体得出（±2–3 cm）。仅在一张照片中可见的窗户会用灰色标记，请用卷尺复核。"
          }
        }
      }
    },
    "Размеры, м": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensions, m"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiones, m"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸，m"
          }
        }
      }
    },
    "Размеры: длина и ширина 0,05–30 м, высота 0,02–10 м.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
