            "state": "translated",
            "value": "Hasta 12 puntos en un mismo contorno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个轮廓最多 12 个点。"
          }
        }
      }
    },
