    "Медленно обходите помещение, наводя камеру на стены, углы, окна и двери.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly walk around the room, pointing the camera at the walls, corners, windows, and doors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorre la habitación despacio, apuntando la cámara a paredes, esquinas, ventanas y puertas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请沿房间四周慢慢走，将镜头对准墙面、墙角、窗户和门。"
          }
        }
      }
    },
    "Медленно поведите телефоном по полу, пока не появится сетка.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly move your phone over the floor until the grid appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el teléfono lentamente sobre el piso hasta que aparezca la cuadrícula."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机对准地面缓慢移动，直到出现网格。"
          }
        }
      }
    },
    "Межэтажные перекрытия": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floor assemblies between stories"
