    "Плитка по раскладке, клей, затирка, маяки, штукатурка, стяжка, гидроизоляция, краска — с упаковками и ценами": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tile quantities based on your layout, plus tile adhesive, grout, screed guides, plaster, screed, waterproofing, and paint—all with package counts and prices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baldosas según el patrón de colocación, adhesivo, mortero para juntas, maestras, revestimiento de yeso o cemento, capa de nivelación, impermeabilización y pintura, con cantidades por envase y precios"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按排砖方案算瓷砖用量，另算瓷砖胶、填缝剂、标筋、抹灰、找平、防水和涂料的用料，含包装数量和价格"
          }
        }
      }
    },
