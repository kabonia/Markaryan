    "354000, г. Сочи, ул. Навагинская, д. 9, оф. 12": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "9 Navaginskaya St., Suite 12, Sochi 354000"
          }
        }
      }
    },
    "3D‑ОБМЕР ДОМА": {
      "extractionState": "manual",
      "localizations": {
