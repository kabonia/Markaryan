      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retail fixtures: shelving and display cases along the walls, a checkout counter with a register, a merchandise display area, plants, and lighting. For a flower shop, add a refrigerated display case and a floral worktable."
          }
        }
      }
    },
