    },
    "Сервер ИИ пока выбирает модели сам: выбор работает с ключом OpenRouter на обновлённом сервере приложения.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI server currently picks models on its own. Model selection works with an OpenRouter key on the updated app server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora el servidor de IA elige los modelos por sí mismo: la selección funciona con una clave de OpenRouter en el servidor actualizado de la app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前由 AI 服务器自动选用模型。要手动选择，需使用 OpenRouter 密钥，且应用服务器须已更新。"
          }
        }
      }
