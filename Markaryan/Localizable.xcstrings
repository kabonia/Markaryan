    "Сервер ИИ не настроен — скан сохранён в телефоне, отправим позже.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI server isn't set up — the scan is saved on your phone and will be sent later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de IA no está configurado: el escaneo se guardó en el teléfono y lo enviaremos después."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 服务器尚未配置，扫描数据已保存在手机上，稍后上传。"
          }
        }
      }
    },
    "Сервер ИИ не ответил. Попробуйте позже.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI server didn't respond. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de IA no respondió. Inténtalo más tarde."
          }
