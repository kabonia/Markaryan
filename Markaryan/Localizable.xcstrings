    "Дальняя часть комнаты сдвинется вдоль стены, мебель и проёмы — вместе с ней.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The far part of the room will shift along the wall, and furniture and openings will move with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte del fondo de la habitación se desplazará a lo largo de la pared, junto con los muebles y las aberturas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间远端部分将沿墙移动，家具和洞口随之移动。"
          }
        }
      }
    },
