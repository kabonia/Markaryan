        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el presupuesto listo en «Mis presupuestos»: encontrarás las partidas por sección, la compra de materiales, las bases del cálculo y las opciones de exportación a PDF y Excel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“我的预算”中打开已生成的预算表，查看分项、材料采购清单和编制依据，或导出 PDF、Excel。"
