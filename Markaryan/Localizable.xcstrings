      }
    },
    "Нормы расхода и техника": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Material usage rates and equipment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumos unitarios y maquinaria"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消耗定额与施工机械"
          }
        }
      }
    },
    "Нормы — типовые нормы производителей (Ceresit, Knauf, Litokol) и СП 71.13330. Плитка посчитана раскладкой по вашей комнате, с запасом 10 %. Толщины слоёв зависят от кривизны стен и пола — проверьте их правилом перед закупкой.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Material usage rates are based on typical manufacturer guidelines (Ceresit, Knauf, Litokol) and SP 71.13330 (Russian building code). The tile estimate is based on your room’s layout and includes 10% extra for waste. Layer thicknesses depend on how uneven your walls and floor are. Check the surfaces with a straightedge before you buy materials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cálculo usa los consumos de referencia de los fabricantes (Ceresit, Knauf, Litokol) y la norma rusa SP 71.13330. La cantidad de baldosas se calcula según su distribución en tu habitación, con un 10 % extra. El espesor de las capas depende de qué tan planos estén las paredes y el piso. Comprueba la planitud con una regla de albañil antes de comprar los materiales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量参考厂家常用定额（Ceresit、Knauf、Litokol）及俄罗斯建筑规范 SP 71.13330。瓷砖用量按您房间的排砖方案计算，另加 10% 余量。各施工层厚度取决于墙地面的平整度，采购前请用靠尺检查。"
          }
        }
      }
    },
    "Нужен ли армопояс?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do I need a bond beam?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Hace falta una cadena de amarre de concreto armado?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要做圈梁吗?"
          }
        }
      }
    },
    "Нужно согласие соседа (письменное) или перенос. От красной линии улицы — 5 м, проезда — 3 м.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get your neighbor’s written consent or move the building. The setback from the designated boundary (red line) is 5 m for a street and 3 m for an access road."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas el consentimiento escrito del vecino o reubicar la construcción. Los retiros desde la línea oficial que delimita la vía son de 5 m para una calle y 3 m para una vía de acceso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "须取得邻居书面同意，或调整建筑位置。距街道红线 5 m，距通行道路红线 3 m。"
          }
        }
      }
    },
