          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala el tomacorriente de la lavadora con protección diferencial (RCD), a una distancia mínima de 0,6 m de la ducha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洗衣机插座应配漏电保护装置（RCD），距淋浴区至少 0.6 m。"
