    "Длины, площадь и периметр камерой телефона — без рулетки.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure lengths, area, and perimeter with your phone camera — no tape measure needed."
          }
        }
      }
    },
    "Для ведения личного подсобного хозяйства": {
      "extractionState": "manual",
      "localizations": {
        "en": {
