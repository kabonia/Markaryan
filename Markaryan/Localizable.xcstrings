    "Стоимость дизайн‑проекта по реальным ценам магазинов и мастеров вашего города: материалы и работы с вилкой цен.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what it would cost to build out your design, with price ranges for materials and labor based on real prices from local stores and contractors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estima el costo de llevar a cabo tu proyecto de diseño con precios reales de tiendas y profesionales de tu ciudad: obtén un rango de precios para los materiales y la mano de obra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当地门店报价和施工师傅的实际收费估算装修造价，分别给出材料费和人工费的区间。"
          }
        }
      }
    },
    "Стоимость по вашей цене": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cost at your unit price"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Costo según tu precio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按您的单价估算"
          }
        }
      }
    },
    "Стоимость только материалов по введённой цене, без работ и доставки.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Materials only, based on the price you entered. Excludes labor and delivery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el costo de los materiales según el precio ingresado, sin mano de obra ni entrega."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅按填写的单价计算材料费，不含施工费和运费。"
          }
        }
      }
    },
