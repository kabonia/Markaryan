            "value": "Signatory"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmante"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签署人"
          }
        }
      }
    },
    "Подписка продлевается автоматически, пока её не отменят в настройках Apple ID не позднее чем за 24 часа до конца периода.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription renews automatically unless you cancel it in your Apple ID settings at least 24 hours before the end of the period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente, a menos que la canceles en los ajustes del ID de Apple al menos 24 horas antes de que termine el período."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续订。如不想续订，请至少在当前订阅期结束前 24 小时前往 Apple ID 设置取消订阅。"
          }
        }
      }
    },
    "Подписывать акты по каждому этапу": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign the acceptance paperwork for each stage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmar actas de cada etapa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个阶段都签署验收单"
          }
        }
      }
    },
    "Подпись к фото, например: армирование плиты": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo caption (e.g., slab rebar)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descripción de la foto, p. ej., armado de la losa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片说明，如：楼板钢筋绑扎"
          }
        }
      }
    },
    "Подпорные стены (монолитный железобетон на буронабивных сваях)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retaining walls (cast-in-place reinforced concrete on drilled piers)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muros de contención (hormigón armado monolítico sobre pilotes perforados)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挡土墙(钻孔灌注桩上的现浇钢筋混凝土)"
          }
        }
      }
    },
    "Подскажет нормы и расход, разберёт смету или фото, покажет, что где.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get help with code requirements and material quantities, review an estimate or photo, and see what’s where."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te orienta sobre las normas y el consumo de materiales, analiza presupuestos o fotos y te muestra qué es cada cosa y dónde está."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解答施工规范和材料用量问题，帮您看懂预算、识别照片里的部位。"
          }
        }
      }
    },
    "Подсчёт по фото с проверкой вручную, ориентировочно.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo-based count is approximate, even after a manual check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteo aproximado a partir de fotos, con revisión manual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据照片计数并经人工核对，结果仅供参考。"
          }
        }
      }
    },
    "Подъёмная техника": {
