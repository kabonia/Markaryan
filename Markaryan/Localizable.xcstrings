    "Дом снят со всех сторон — можно нажимать «Готово»": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've scanned all sides of the house. Tap “Done” to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La casa está escaneada por todos lados: ya puedes tocar «Listo»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房屋各面均已拍摄，可轻点“完成”"
          }
        }
      }
    },
    "Дом, баня, беседка, кровля, фасад и участок как единый образ.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the house, sauna, gazebo, roof, exterior, and lot together in one design."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casa, sauna, cenador, techo, fachada y terreno como una sola imagen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统筹呈现住宅、桑拿房、凉亭、屋顶、外立面和地块的整体效果。"
          }
        }
      }
    },
    "Дом, навес, ангар, забор — по размерам, с работами, техникой и доставкой": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Houses, carports, hangars, and fences: estimates based on dimensions, including labor, equipment, and delivery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casa, cobertizo, nave, cerco: según medidas, con trabajos, maquinaria y entrega"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "住宅、棚体、大跨度库房、围栏——按尺寸估价，含施工、机械和运输费用。"
          }
        }
      }
    },
