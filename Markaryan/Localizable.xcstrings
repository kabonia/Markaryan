      }
    },
    "Листов: %lld из %lld. Укажите тип каждого документа — АР, КР, ТЗ или смета: агенты читают их по‑разному.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheets: %lld of %lld. Choose a type for each document: architectural drawings, structural drawings, project brief, or cost estimate. The AI agents process each type differently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hojas: %lld de %lld. Indica el tipo de cada documento: AR (arquitectura), KR (estructura), especificación técnica o presupuesto; los agentes los leen de forma distinta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页数：%lld/%lld。请为每份文件选择类型：建筑图（АР）、结构图（КР）、任务书（ТЗ）或工程估算。智能体会按类型采用不同的解析方式。"
          }
        }
      }
    },
    "Листовой металл и крепёж": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet metal and fasteners"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lámina metálica y sujetadores"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金属板材与紧固件"
          }
        }
      }
    },
    "Листы = длина / полезная ширина × запас, вверх. Столбы = длина / шаг, вверх, + 1. Лаги = длина × ряды × запас. Бетон = π × (лунка / 2)² × заглубление × столбы × запас": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panels = fence length / panel coverage width × waste factor, rounded up. Posts = fence length / post spacing, rounded up, then add 1. Rails = fence length × number of rail rows × waste factor. Concrete = π × (post hole diameter / 2)² × embedment depth × number of posts × waste factor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Láminas = largo / ancho útil × factor de desperdicio; redondea hacia arriba. Postes = largo / separación; redondea hacia arriba y suma 1. Travesaños = largo × número de filas × factor de desperdicio. Concreto = π × (diámetro del hoyo / 2)² × profundidad de empotramiento × número de postes × factor de desperdicio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "板数 = 长度 / 有效宽度 × 损耗系数，向上取整。立柱 = 长度 / 间距，向上取整，+ 1。横梁 = 长度 × 道数 × 损耗系数。混凝土 = π × (柱坑直径 / 2)² × 埋深 × 立柱数 × 损耗系数"
          }
        }
      }
    },
    "Листы = площадь без проёмов × слои × запас / площадь листа, вверх. Саморезы = листы × саморезы на лист": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheets = (area excluding openings) × layers × waste factor / area per sheet, rounded up. Screws = sheets × screws per sheet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Placas = área sin aberturas × número de capas × factor de desperdicio / área por placa; redondea hacia arriba. Tornillos autorroscantes = placas × tornillos por placa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "板材张数 = 扣除洞口后的净面积 × 层数 × 损耗系数 / 单张板面积，向上取整。自攻螺钉数 = 板材张数 × 每张板所需螺钉数。"
          }
        }
      }
    },
    "Листы · слои · саморезы": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheets · layers · screws"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planchas · capas · tornillos autorroscantes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "板数 · 层数 · 自攻螺丝"
          }
        }
      }
    },
