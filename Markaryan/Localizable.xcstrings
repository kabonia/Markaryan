    "Унитаз, раковина с тумбой, душ или ванна, стиральная машина, зеркало, полотенцесушитель, шкаф, точки воды, канализации и розеток. Без кухни, дивана, кровати.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toilet, vanity with sink, shower or tub, washer, mirror, towel warmer, cabinet, water supply and drain connections, and electrical outlets. No kitchen, sofa, or bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inodoro, lavabo con mueble, ducha o bañera, lavadora, espejo, toallero calefactable, armario, puntos de agua, desagüe y tomacorrientes. Sin cocina, sofá ni cama."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马桶、带柜洗手盆、淋浴或浴缸、洗衣机、镜子、电热毛巾架、储物柜，以及给排水和插座点位。不含厨房、沙发和床。"
          }
        }
      }
    },
    "Упаковки = площадь × запас / площадь упаковки, вверх. Клей = площадь × расход × запас": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxes = area × waste factor / coverage per box, rounded up. Adhesive = area × adhesive use rate × waste factor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cajas = área × factor de desperdicio / área por caja; redondea hacia arriba. Adhesivo = área × consumo × factor de desperdicio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包数 = 面积 × 损耗系数 / 每包覆盖面积，向上取整。瓷砖胶用量 = 面积 × 单位面积用量 × 损耗系数。"
          }
        }
      }
    },
