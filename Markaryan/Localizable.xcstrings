      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "B22.5 (M300) P3/P4 ready-mix concrete. B22.5 corresponds to M300, while M350 corresponds to B25. Prices shown are for B22.5. For B25 (M350), the same suppliers…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concreto premezclado B22,5 (M300), P3/P4. La clase B22,5 corresponde a M300, mientras que M350 corresponde a B25. Los precios corresponden a B22,5. Para B25 (M350), los mismos proveedores…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商品混凝土 B22.5（M300），P3/P4。按等级对应关系，B22.5 对应 M300，M350 对应 B25。所列报价适用于 B22.5。关于 B25（M350），原文提到同一批供应商……"
          }
        }
      }
