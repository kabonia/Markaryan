    "Добавлено проверкой работ: %lld — отмечены в смете.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The work review added %lld items and flagged them in the estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión de trabajos añadió %lld partidas, marcadas en el presupuesto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "施工项目核查新增 %lld 项，已在工程估算中标注。"
          }
        }
      }
    },
    "Добавляйте фото выполненных этапов, скрытых работ и согласованных решений. Они останутся на вашем iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photos of completed phases, work that will be covered up, and approved choices. Your photos stay on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega fotos de las etapas terminadas, trabajos ocultos y decisiones acordadas. Se quedarán en tu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加已完工工序、隐蔽工程和已确认方案的照片。照片仅保存在你的 iPhone 上。"
          }
        }
      }
    },
    "Добавьте первую запись: встреча, решение или выполненный этап.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first entry: a meeting, a decision, or a completed stage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu primera entrada: una reunión, una decisión o una etapa terminada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加第一条记录：会议、决定或已完成的阶段。"
          }
        }
      }
    },
    "Добавьте работу, укажите ответственного и срок.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a task, assign someone and set a due date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tarea e indica quién se encargará y para cuándo debe estar lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加工作内容，指定负责人和期限。"
          }
        }
      }
    },
    "Добавьте район или адрес — он попадёт в PDF‑сметы и чертежи.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an area or address. It will appear on PDF estimates and drawings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la zona o la dirección: aparecerá en los presupuestos en PDF y en los planos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加所在区域或地址，相关信息将显示在 PDF 工程估价单和图纸上。"
          }
        }
      }
    },
    "Добро пожаловать в СметаПро": {
