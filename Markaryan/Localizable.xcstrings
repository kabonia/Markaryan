    "Баланс кредитов, подписка и цены платных функций. Калькуляторы, замеры и типовые сметы — бесплатно.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your credit balance, subscription, and prices for paid features. Calculators, measurements, and standard estimates are free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo de créditos, suscripción y precios de las funciones de pago. Las calculadoras, mediciones y presupuestos tipo son gratis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看积分余额、订阅和付费功能价格。计算器、测量和常规工程预算免费。"
          }
        }
      }
    },
