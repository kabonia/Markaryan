    "Проёмы должны занимать меньше общей площади стен.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The combined area of the openings must be less than the total wall area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El área de las aberturas debe ser menor que el área total de los muros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洞口面积必须小于墙体总面积。"
          }
        }
      }
    },
    "Проёмы должны занимать меньше площади обшивки.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The combined area of the openings must be less than the total sheathing area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El área de las aberturas debe ser menor que el área del revestimiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洞口面积必须小于饰面面积。"
          }
        }
      }
    },
    "Проёмы должны занимать меньше площади поверхности.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The combined area of the openings must be less than the total surface area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El área de las aberturas debe ser menor que el área de la superficie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洞口面积必须小于表面面积。"
          }
        }
      }
    },
    "Проёмы не выявлены": {
