    "Сканируйте любое помещение — комнату, гараж, магазин. Получите план, стиль, визуализацию и чертежи.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan any indoor space—a room, garage, or store. Get a floor plan, design style, renderings, and drawings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea cualquier espacio: una habitación, un garaje, un local. Obtén el plano, el estilo, la visualización y los planos técnicos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描房间、车库、店铺等室内空间，获取平面图、风格方案、效果图和图纸。"
          }
        }
      }
    },
