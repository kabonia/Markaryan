    "Плитка, стяжка, штукатурка, краска, гипсокартон — по размерам скана": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tile, screed, plaster, paint, and drywall quantities based on scan dimensions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baldosas, contrapiso, revoque, pintura, drywall: según las medidas del escaneo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "瓷砖、找平层、抹灰、涂料、石膏板——按扫描尺寸计算"
          }
        }
      }
    },
    "Плитка, фасад, унитаз, раковина, обои, ламинат, светильник — пришлите фото или файл, ИИ узнает, что это, спросит, куда и как, и поставит именно это.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tile, siding, a toilet, a sink, wallpaper, laminate flooring, or a light fixture—upload a photo or file. AI will identify the item, ask where and how you want to use it, and add that exact item to your design."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Azulejos, revestimientos de fachada, inodoros, lavabos, papel tapiz, pisos laminados, luminarias… Envía una foto o un archivo. La IA identificará el material o producto, te preguntará dónde y cómo colocarlo y lo incorporará tal cual a tu diseño."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "瓷砖、外墙饰面、马桶、洗手盆、壁纸、强化地板、灯具……上传照片或文件，AI 会识别物品，询问放在哪儿、怎么布置，再把您提供的这款物品放进设计中。"
          }
        }
      }
    },
