    "8. Вентиляция: вытяжной вентилятор с обратным клапаном; подрез двери 20 мм для притока воздуха.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Ventilation: exhaust fan with backdraft damper; undercut the door 20 mm for air supply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Ventilación: extractor con válvula antirretorno; deja 20 mm bajo la puerta para la entrada de aire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8. 通风:排风扇带止回阀;门底留 20 mm 缝隙进风。"
          }
        }
      }
    },
