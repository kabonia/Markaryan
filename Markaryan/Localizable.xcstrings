          }
        }
      }
    },
    "Объём бетона · опалубка · стоимость": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concrete volume · formwork · cost"
          }
