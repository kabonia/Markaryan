    "Гарнитур с мойкой и плитой, техника, обеденная зона, точки подключения. Без сантехники санузла и кровати.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitchen cabinets with a sink and range, appliances, a dining area, and utility hookups. No bathroom fixtures or bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muebles de cocina con fregadero y estufa, electrodomésticos, zona de comedor y puntos de conexión. Sin aparatos sanitarios ni cama."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带水槽和灶具的橱柜、电器、用餐区和设备接驳点位。不含卫生间洁具和床。"
          }
        }
      }
    },
