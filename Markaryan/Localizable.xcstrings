    "Скан комнаты, обмеры и рендеры — во вкладке «Дизайн»": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room scans, measurements and renders are in the Design tab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pestaña «Diseño» encontrarás el escaneo de la habitación, las mediciones y los renders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设计”标签页可查看房间扫描、测量和效果图"
          }
        }
      }
    },
    "Скан лидаром, обмеры, стиль и фотореалистичный рендер по точной геометрии.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with LiDAR, take measurements, and choose a style. Get a photorealistic rendering based on your room’s exact dimensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneo con LiDAR, mediciones, estilo y render fotorrealista con geometría exacta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 LiDAR 扫描测量，选定风格后，按实测尺寸和结构生成照片级效果图。"
          }
        }
      }
    },
