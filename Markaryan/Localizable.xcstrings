      }
    },
    "по часовой стрелке на плане, стена 1 — с входной дверью (без дверей — верхняя); from/to — метры от начала стены по ходу нумерации": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number the walls clockwise on the floor plan. Wall 1 is the wall with the entry door. If there are no doors, start with the top wall. Measure from/to in meters from the start of each wall, following the numbering direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "en sentido horario en el plano; la pared 1 es la de la puerta de entrada (si no hay puertas, la de arriba); from/to: metros desde el inicio de la pared en el sentido de la numeración"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墙体按平面图顺时针编号：入户门所在的墙为 1 号墙；如无门，则从图中最上方的墙开始。from/to 为沿编号方向从墙起点量起的距离（m）。"
          }
        }
      }
    },
    "по числу выводов — уточните": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the number of pipe and drain openings — verify the count"
