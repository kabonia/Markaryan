      }
    },
    "Например: душ с трапом вместо ванны, подвесной унитаз, место под стиральную машину": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: a shower with a floor drain instead of a tub, a wall-hung toilet, or room for a washer"
