      }
    },
    "Отвечает потоком, как в чате, и помнит контекст разговора": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams replies and keeps track of the conversation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la respuesta a medida que la genera, como en un chat, y recuerda el contexto de la conversación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像聊天一样流式回复，并记住对话上下文"
          }
        }
      }
    },
    "Отвечай одним коротким предложением по-русски.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply in one short sentence in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde en ruso con una sola oración breve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用俄语简短地回答一句。"
          }
        }
      }
    },
    "Отвечу про нормы и расход материалов, разберу смету или фото, подскажу, где что в приложении. Сейчас открыто: «%@».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can answer questions about codes and material usage, review a cost estimate or photo, and show you where things are in the app. Currently open: “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te respondo sobre normas y consumo de materiales, reviso tu presupuesto o una foto, y te indico dónde está cada cosa en la app. Ahora tienes abierto: «%@»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以解答施工规范和材料用量问题，帮你看工程估算单或照片，也能告诉你应用里的功能在哪。当前打开的是“%@”。"
          }
        }
      }
    },
