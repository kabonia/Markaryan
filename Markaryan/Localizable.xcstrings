            "state": "translated",
            "value": "3D HOUSE MEASUREMENT"
          }
        }
      }
    },
    "3D‑модели нет — только размеры.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No 3D model — dimensions only."
          }
        }
      }
    },
