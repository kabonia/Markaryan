          "stringUnit": {
            "state": "translated",
            "value": "例如:浅色地板、更多收纳、窗边工作区"
          }
        }
      }
    },
    "Например: сделай стены темнее, убери люстру, добавь растения": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
