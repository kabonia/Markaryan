    "AR‑замер приблизительный: для закупки и разметки перепроверяйте рулеткой.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AR measurements are approximate. Double-check with a tape measure before ordering materials or marking your layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición con realidad aumentada es aproximada. Verifica las medidas con una cinta métrica antes de comprar materiales o hacer el trazado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AR测量仅为估算:采购和放线前请用卷尺复核。"
          }
        }
      }
    },
    "AR‑рулетка": {
      "extractionState": "manual",
