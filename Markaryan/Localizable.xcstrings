    "Цемент": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cement"
          }
        }
      }
    },
    "Цемент · песок · щебень · вода на замес": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cement · sand · crushed stone · water per batch"
          }
        }
      }
    },
    "Цемент на 1 м³ = 980 л / (1/3,1 + (песок + щебень)/2,65 + В/Ц); песок и щебень = цемент × части; вода = цемент × В/Ц. Насыпная плотность: песок 1500, щебень 1450 кг/м³": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cement per 1 m³ = 980 L / (1/3.1 + (sand parts + crushed stone parts)/2.65 + w/c). Sand and crushed stone weights = cement weight × their respective mix parts. Water weight = cement weight × w/c. Bulk density: sand 1500 kg/m³, crushed stone 1450 kg/m³"
          }
        }
      }
    },
    "Цемент на 1 м³ по пропорциям": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cement per 1 m³ by mix ratio"
          }
        }
      }
    },
