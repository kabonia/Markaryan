            "value": "Existing conditions plan, furniture layout, electrical plan, tile layout, and interior elevations—all drawn to scale on A3 sheets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plano del estado actual con cotas, distribución de muebles, plano eléctrico, despiece de revestimientos y alzados interiores: láminas A3 a escala."
          }
