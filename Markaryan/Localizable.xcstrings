    "Что где находится и для чего — за минуту": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one minute, see where to find the tools and what they do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un minuto, descubre dónde está cada opción y para qué sirve"
