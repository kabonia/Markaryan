    "Окна": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventanas"
