    "Сумма, ₽": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount, ₽"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe, ₽"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额（₽）"
          }
        }
      }
    },
    "Суммарная длина лент измеряется по осевым линиям, пересечения не должны учитываться дважды. Сечение постоянное; без ступеней и уширений. Опалубка — две боковые стороны на всю высоту.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure the total length along the footing centerlines. Count each intersection only once. The cross section is uniform, with no steps or widened sections. Set full-height forms on both sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide la longitud total de los cimientos corridos a lo largo de sus ejes, sin contar dos veces los cruces. La sección es constante, sin escalones ni ensanchamientos. El encofrado va en ambas caras laterales, a toda la altura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条形基础总长按轴线计算,交叉处不得重复计入。截面恒定,无台阶和加宽。模板为两侧全高侧模。"
          }
        }
      }
    },
