          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 console.anthropic.com 获取密钥"
          }
        }
      }
    },
    "Пом.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间"
          }
        }
      }
    },
    "Помощник видит параметры текущего расчёта и объясняет объёмы, смету и порядок работ. Он не заменяет проектировщика для несущих конструкций.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant uses the inputs from your current calculation to explain quantities, costs, and the order of work. For load-bearing design, consult a structural engineer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente consulta los datos del cálculo actual y explica las cantidades de obra, el presupuesto y el orden de los trabajos. No sustituye al proyectista en el diseño de estructuras portantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手可读取本次计算的参数，帮您了解工程量、工程估算和施工顺序。承重结构仍须由专业人员设计。"
          }
        }
      }
    },
    "Помощник пока не подключён к серверу. Калькуляторы, сметы и замеры работают и без него.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant isn't connected to the server yet. Calculators, estimates, and measurements work without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente aún no está conectado al servidor. Las calculadoras, los presupuestos y las mediciones funcionan sin él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手暂未连接服务器。计算器、工程估算和测量功能仍可使用。"
          }
        }
      }
    },
    "Помощник сверх бесплатных": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant use beyond the free allowance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta adicional al asistente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手提问（超出免费额度）"
          }
        }
      }
    },
    "Помощник — кнопка со звёздочкой — подскажет на любом шаге.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant (the sparkle button) can help you at any step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón con la estrella para recibir ayuda del asistente en cualquier paso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点星形按钮，随时获得助手提示。"
          }
        }
      }
    },
    "Понятно": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了"
          }
        }
      }
    },
    "Понятно, начнём": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s get started"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido, empecemos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "Пополнить баланс или оформить подписку можно на этом экране.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add credits or subscribe on this screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta pantalla puedes recargar saldo o suscribirte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在此页面充值或订阅。"
          }
        }
      }
    },
    "Попробовать": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试看"
          }
        }
      }
    },
    "Попробовать дизайн по фото": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try photo redesign"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar diseño con una foto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试拍照设计"
          }
        }
      }
    },
    "Попробуйте ещё раз через минуту. Если повторится — мы уже получили отчёт и исправим это.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in a minute. If the problem comes back, don’t worry—we’ve already received the report and will fix it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo en un minuto. Si el problema persiste, no te preocupes: ya recibimos el informe y lo corregiremos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请过一分钟再试。如果问题再次出现，请放心，我们已收到错误报告，会进行修复。"
          }
        }
      }
    },
    "Популярное": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Popular"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Popular"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热门"
          }
        }
      }
    },
    "Порядок оплаты": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment terms"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Condiciones de pago"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款安排"
          }
        }
      }
    },
    "После обхода измерьте рулеткой одну стену — макет подгонится под этот размер.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the walk-around, measure one wall with a tape measure — the model will be adjusted to that dimension."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras el recorrido, mide un muro con cinta métrica: el modelo se ajustará a esa medida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕屋拍摄后，用卷尺量一面墙的长度，模型将按该尺寸校准。"
          }
        }
      }
    },
    "После расчёта — PDF, сохранение и отправка.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you have your results, you can save them, share them, or export them as a PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de calcular, puedes exportar el resultado a PDF, guardarlo o compartirlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算后可生成 PDF、保存和发送。"
          }
        }
      }
    },
    "После такой правки стены пересекутся. Возьмите значение поменьше.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this change, the walls would intersect. Use a smaller value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con este cambio las paredes se cruzarían. Usa un valor menor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样修改后墙体会相交。请输入更小的数值。"
          }
        }
      }
    },
    "Посмотри фото.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a look at the photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la foto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看这张照片。"
          }
        }
      }
    },
    "Поставьте задачу и укажите ответственного": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a task and assign it to someone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una tarea y asigna un responsable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建任务并指定负责人"
          }
        }
      }
    },
    "Поставьте следующую точку — появится длина; замкните контур для площади.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the next point to see the length. Close the outline to get the area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el siguiente punto para ver la longitud; cierra el contorno para obtener el área."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记下一个点即可看到长度；闭合测量轮廓即可得到面积。"
          }
        }
      }
