    "ИИ вернул неожиданный ответ. Попробуйте ещё раз.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI returned an unexpected response. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA devolvió una respuesta inesperada. Inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 返回了意外的响应。请重试。"
          }
        }
      }
    },
    "ИИ временно недоступен. Попробуйте позже.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is temporarily unavailable. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA no está disponible por el momento. Inténtalo más tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 暂时不可用。请稍后再试。"
          }
        }
      }
    },
    "ИИ изучает расчёт…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is reviewing the calculation…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA está revisando el cálculo…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 正在分析计算结果…"
          }
        }
      }
    },
    "ИИ не подключён: впишите OPENROUTER_API_KEY в AIServer.plist и пересоберите приложение.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI isn't connected: add OPENROUTER_API_KEY to AIServer.plist and rebuild the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA no está conectada: agrega OPENROUTER_API_KEY en AIServer.plist y vuelve a compilar la app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 未连接：请在 AIServer.plist 中填写 OPENROUTER_API_KEY 并重新编译应用。"
          }
        }
      }
    },
    "ИИ не подключён: впишите OPENROUTER_API_KEY в AIServer.plist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
