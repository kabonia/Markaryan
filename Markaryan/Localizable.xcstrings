    "Собрать исполнительную и гарантийную документацию": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect as-built records and warranty documents"
          }
        },
        "es": {
