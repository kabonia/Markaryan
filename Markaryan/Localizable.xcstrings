    "Приложение для тех, кто строит и ремонтирует: сметы по проекту, дизайн интерьера, расчёт материалов и замеры камерой.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app for building and remodeling: cost estimates from plans, interior design, material calculations, and camera measurements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app para quienes construyen y remodelan: presupuestos a partir de planos y documentos del proyecto, diseño de interiores, cálculo de materiales y mediciones con la cámara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建房装修都能用：按项目做预算、做室内设计、算材料用量，还能用相机测量。"
          }
        }
      }
    },
