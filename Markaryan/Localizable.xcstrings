    "сначала сам определи, что изображено (арматура, трубы, доски, брус или другие предметы — гайки, болты, кирпичи, мешки и т.п.), и считай именно эти предметы": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, identify what's shown (rebar, pipes, boards, timbers, or other items such as nuts, bolts, bricks, or bags). Then count only the items of that type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "primero identifica qué aparece en la imagen (varillas de refuerzo, tubos, tablas, vigas de madera u otros objetos, como tuercas, pernos, ladrillos o sacos) y cuenta solo los objetos que hayas identificado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先自行识别图中物品（钢筋、管材、木板、方木，或螺母、螺栓、砖块、袋装材料等其他物品），然后只统计识别出的这类物品。"
          }
        }
      }
    },
