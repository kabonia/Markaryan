      }
    },
    "AR‑рулетка, калькуляторы материалов и счёт арматуры по фото — без рулетки и таблиц.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure with AR, calculate materials, and count rebar from a photo. No tape measure or spreadsheets needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinta métrica en AR, calculadoras de materiales y conteo de varillas de refuerzo a partir de fotos, sin cinta métrica ni hojas de cálculo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AR 卷尺测尺寸、材料计算器算用量，还能拍照数钢筋，无需实体卷尺或电子表格。"
          }
