            "state": "translated",
            "value": "解读工程预算，找出能省钱的地方"
          }
        }
      }
    },
    "Объём": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体积"
          }
        }
      }
    },
    "Объём = площадь × толщина × запас. Упаковки = объём / объём упаковки, вверх": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume = area × thickness × waste factor. Packs = volume / pack volume, rounded up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen = área × espesor × factor de desperdicio. Paquetes = volumen / volumen por paquete; redondea hacia arriba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体积 = 面积 × 厚度 × 损耗系数。包数 = 体积 / 每包体积，向上取整"
          }
        }
      }
    },
    "Объём · толщина · упаковки": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
