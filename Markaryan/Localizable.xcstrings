    "Мокрая зона до потолка, остальное — влагостойкая краска; гидроизоляция в душе на 2 м": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tile wet areas to the ceiling and use moisture-resistant paint elsewhere; waterproof shower walls to a height of 2 m"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviste la zona húmeda hasta el techo y usa pintura resistente a la humedad en el resto; impermeabiliza la ducha hasta 2 m de altura"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "湿区墙砖贴至顶面，其余墙面刷防潮涂料；淋浴区墙面防水做到 2 m 高"
