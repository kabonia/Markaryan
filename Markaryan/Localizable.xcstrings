            "state": "translated",
            "value": "Claude está sobrecargado en este momento. Inténtalo un poco más tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 目前负载过高。请稍后再试。"
