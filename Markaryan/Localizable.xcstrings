        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alambre de atar de 1,2 mm tratado térmicamente (recocido), GOST 3282-74, en rollo. Listas de precios de Krasnodar y Rostov del Don: precios mayoristas en Sochi…"
          }
