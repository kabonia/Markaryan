    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used for AR measurements of distances and areas, 3D house scans, placing models on site, and photos of your project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para medir distancias y áreas con RA, escanear tu casa en 3D, colocar modelos en el terreno y tomar fotos de tu obra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна для AR-замеров расстояний и площади, размещения макета на площадке и съёмки фото объекта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用于 AR 测量距离和面积、房屋 3D 扫描、在现场放置模型以及拍摄项目照片。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to apply local prices to estimates and to place your house scan on the map and relative to the sun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación se usa para aplicar precios locales a los presupuestos y situar el escaneo de tu casa en el mapa y respecto al sol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение нужно, чтобы подставить в смету цены вашего региона, найти ваш участок на кадастровой карте и привязать скан дома к карте и солнцу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置信息用于在估价中使用当地价格，并将房屋扫描定位到地图上及相对太阳的方位。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used for voice commands: \"add to project…\", tasks, expenses and notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se usa para comandos de voz: «añadir al proyecto…», tareas, gastos y notas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон нужен для голосовых команд: «добавь в объект…», задачи, траты и записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风用于语音命令：“添加到项目……”、任务、支出和记录。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission is needed to save finished visualizations to your Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso para guardar las visualizaciones terminadas en Fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение нужно, чтобы сохранять готовые визуализации в приложении Фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要权限才能将完成的效果图保存到“照片”。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition turns a voice command into a task, expense or project note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz convierte un comando de voz en una tarea, un gasto o una nota del proyecto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи превращает голосовую команду в задачу, трату или запись объекта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别会将语音命令转换为项目的任务、支出或记录。"
          }
        }
      }
    }
  },
  "version": "1.0"
}